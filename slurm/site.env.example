# Site settings for the slurm wrappers. Copy to slurm/site.env (git-ignored) and fill in your cluster's values.
#
# Load it in the shell you submit from (e.g. in ~/.bashrc):   . /path/to/this/repository/slurm/site.env
# Every job loads it again through slurm/_site.sh. sbatch takes the SBATCH_* variables below as the account, partition
# and QoS of every job (the wrappers carry no site-specific #SBATCH lines).

# --- scheduler ---------------------------------------------------------------------------------------------------
export SBATCH_ACCOUNT=your-account
export SBATCH_PARTITION=your-partition
export SBATCH_QOS=normal

# --- storage -----------------------------------------------------------------------------------------------------
# BAMs are written to <PREPROCESSING_DIR>/<cohort>/<ID>.hg38.frag.tsv.bam
export PREPROCESSING_DIR=/path/to/preprocessing
# downloaded fragment files go to <FRAGMENT_DIR>/<cohort>_frag/<ID>.hg38.frag.tsv.bgz (about 0.27 GB per record)
export FRAGMENT_DIR=${PREPROCESSING_DIR}
# hg38 analysis set reference (UCSC hg38.analysisSet.fa) with its samtools faidx index (.fai) next to it
export GENOME=/path/to/reference_genome/hg38.analysisSet.fa
# temporary BED/SAM files of the conversion, roughly 12 GB per record converted in parallel (estimate); empty = the output folder
export CONVERT_TMP=

# --- software ----------------------------------------------------------------------------------------------------
# Command prefix that provides samtools, bedtools, htslib and python. One of:
#  - the pixi environment of this repository (pixi install --frozen once):
export RUN="pixi run --frozen"
#  - the Apptainer image built from container.def, when the storage does not allow pixi to set file permissions
#    (pixi install then fails with "Operation not permitted"); bind the folder that holds the repository and the data:
# export RUN="apptainer exec --bind /path/to/storage preprocessing.sif"
# export APPTAINER_CACHEDIR=/tmp/${USER}/apptainer_cache
# export APPTAINER_TMPDIR=/tmp/${USER}/apptainer_tmp
#  - empty, when the tools are already on PATH (e.g. module load lines in this file)
